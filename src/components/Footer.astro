---
import { getDictionary } from '../lib/translations';
import { localePath, type Locale } from '../lib/i18n';
import { siteConfig } from '../lib/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);

const socialLinks = [
	{ label: 'Facebook', href: 'https://facebook.com', icon: 'facebook' },
	{ label: 'Instagram', href: 'https://instagram.com', icon: 'instagram' },
	{ label: 'X', href: 'https://x.com', icon: 'x' },
];
---

<footer class="section-shell mt-10 pb-10 pt-4">
	<div class="paper-panel rounded-[2.5rem] px-6 py-8 sm:px-8">
		<div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
			<div class="max-w-md">
				<div class="flex items-center gap-3">
					<span class="grid h-10 w-10 place-items-center rounded-full bg-[color:var(--ink)] text-sm font-semibold text-white">寿</span>
					<div>
						<p class="text-xs uppercase tracking-[0.3em] text-[color:var(--muted)]">{siteConfig.tagline}</p>
					</div>
				</div>
				<p class="mt-5 max-w-sm text-sm leading-7 text-[color:var(--muted)]">{siteConfig.description}</p>
				<div class="mt-6 flex items-center gap-3">
					{socialLinks.map((social) => (
						<a
							href={social.href}
							target="_blank"
							rel="noreferrer"
							aria-label={social.label}
							class="grid h-10 w-10 place-items-center rounded-full border border-[color:var(--line)] bg-white/70 text-[color:var(--ink)] transition hover:bg-white"
						>
							{social.icon === 'facebook' && (
								<svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M13.5 21v-7h2.3l.4-2.8h-2.7V9.4c0-.8.2-1.4 1.4-1.4H16V5.5c-.2 0-.9-.1-1.8-.1-1.8 0-3.1 1.1-3.1 3.2v1.8H9v2.8h2.3v7h2.2Z"/></svg>
							)}
							{social.icon === 'instagram' && (
								<svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M7.8 3h8.4A4.8 4.8 0 0 1 21 7.8v8.4a4.8 4.8 0 0 1-4.8 4.8H7.8A4.8 4.8 0 0 1 3 16.2V7.8A4.8 4.8 0 0 1 7.8 3Zm0 1.8A3 3 0 0 0 4.8 7.8v8.4a3 3 0 0 0 3 3h8.4a3 3 0 0 0 3-3V7.8a3 3 0 0 0-3-3H7.8Zm8.7 1.4a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Z"/></svg>
							)}
							{social.icon === 'x' && (
								<svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M18.9 3H21l-4.6 5.3L21.8 21h-4.7l-3.7-4.9L9.1 21H7l5-5.7L2.2 3h4.8l3.4 4.6L18.9 3Zm-1.6 16.4h1.3L6.3 4.5H5l12.3 14.9Z"/></svg>
							)}
						</a>
					))}
				</div>
			</div>

			<div class="grid gap-8 lg:grid-cols-[minmax(0,18rem)_minmax(0,18rem)]">
				<div id="footer-contact" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
					<div class="rounded-[1.5rem] bg-white/70 p-4">
						<p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-[color:var(--muted)]">Hours</p>
						<p class="mt-3 text-sm leading-6 text-[color:var(--ink)]">Mon to Sun</p>
						<p class="text-sm leading-6 text-[color:var(--ink)]">11:30 AM - 10:00 PM</p>
					</div>
					<div class="rounded-[1.5rem] bg-white/70 p-4">
						<p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-[color:var(--muted)]">Contact</p>
						<p class="mt-3 text-sm leading-6 text-[color:var(--ink)]">{siteConfig.phone}</p>
						<p class="text-sm leading-6 text-[color:var(--ink)]">{siteConfig.email}</p>
						<p class="mt-2 text-sm leading-6 text-[color:var(--ink)]">{siteConfig.address.streetAddress}</p>
						<p class="text-sm leading-6 text-[color:var(--ink)]">{siteConfig.address.postalCode}, {siteConfig.address.addressCountry}</p>
					</div>
				</div>

				<nav class="grid gap-3 text-sm font-medium text-[color:var(--muted)] lg:min-w-[20rem]">
					<a href={`${localePath(locale)}#story`} class="transition hover:text-[color:var(--ink)]">{dict.footer.about}</a>
					<a href={`${localePath(locale)}#testimonials`} class="transition hover:text-[color:var(--ink)]">{dict.footer.testimonials}</a>
					<a href={`${localePath(locale)}#footer-contact`} class="transition hover:text-[color:var(--ink)]">{dict.footer.contact}</a>
					<a href={`${localePath(locale)}#menu`} class="transition hover:text-[color:var(--ink)]">{dict.footer.offers}</a>
				</nav>
			</div>
		</div>

		<div class="mt-8 border-t border-[color:var(--line)] pt-5 text-sm text-[color:var(--muted)]">
			{dict.footer.copyright}
		</div>
	</div>
</footer>
