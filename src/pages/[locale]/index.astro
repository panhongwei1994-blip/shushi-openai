---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LanguageSwitcher } from '../../components/LanguageSwitcher';
import { ShopExperience } from '../../components/ShopExperience';
import { menuCategories, menuProducts } from '../../data/menu';
import { getDictionary } from '../../lib/translations';
import { defaultLocale, isLocale, localePath, locales, type Locale } from '../../lib/i18n';
import { siteConfig } from '../../lib/site';

export function getStaticPaths() {
	return locales.filter((locale) => locale !== defaultLocale).map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
if (!isLocale(localeParam)) {
	throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale = localeParam as Locale;
const dict = getDictionary(locale);
const pathname = `/${locale}/`;

const menuSchema = {
	'@context': 'https://schema.org',
	'@type': 'Menu',
	name: `${siteConfig.name} menu`,
	hasMenuSection: menuCategories.map((category) => ({
		'@type': 'MenuSection',
		name: dict.menu.categories[category],
		hasMenuItem: menuProducts
			.filter((product) => product.category === category)
			.map((product) => ({
				'@type': 'MenuItem',
				name: product.title[locale],
				description: product.description[locale],
				image: `${siteConfig.url}${product.image}`,
				offers: {
					'@type': 'Offer',
					priceCurrency: siteConfig.currency,
					price: product.price,
				},
			})),
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: dict.seo.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const bootstrappedCatalog = {
	currency: siteConfig.currency,
	locale,
	categories: menuCategories,
	products: menuProducts.map((product) => ({
		id: product.id,
		slug: product.slug,
		category: product.category,
		price: product.price,
		title: product.title[locale],
		description: product.description[locale],
	})),
};
---

<BaseLayout
	locale={locale}
	title={dict.meta.homeTitle}
	description={dict.meta.homeDescription}
	pathname={pathname}
	schema={[menuSchema, faqSchema]}
>
	<header class="section-shell relative z-50 pt-6">
		<div class="paper-panel fade-up flex items-center justify-between rounded-full px-5 py-4">
			<a href={pathname} class="flex items-center gap-3">
				<span class="grid h-10 w-10 place-items-center rounded-full bg-[color:var(--ink)] text-sm font-semibold text-white">寿</span>
				<div>
					<p class="text-xs uppercase tracking-[0.3em] text-[color:var(--muted)]">{siteConfig.tagline}</p>
					<p class="text-lg font-semibold">{siteConfig.name}</p>
				</div>
			</a>
			<nav class="hidden items-center gap-6 text-sm font-medium text-[color:var(--muted)] md:flex">
				<a href="#menu">{dict.nav.menu}</a>
				<a href="#story">{dict.nav.story}</a>
				<a href={localePath(locale, '/checkout/')}>{dict.nav.checkout}</a>
			</nav>
			<LanguageSwitcher client:load currentLocale={locale} pathname={pathname} />
		</div>
	</header>

	<main class="pb-36 lg:pb-20">
	<main class="pb-36 lg:pb-20">
		<section class="section-shell pt-8 sm:pt-12">
			<div class="relative grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-center">
				<div class="fade-up relative z-10">
					<div class="flex items-center gap-3">
						<div class="pill bg-[color:var(--accent)]/10 text-[color:var(--accent)]">{dict.hero.eyebrow}</div>
						<div class="flex items-center gap-2 rounded-full border border-[color:var(--line)] bg-white/50 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-[color:var(--muted)] backdrop-blur-sm">
							<span class="pulse-dot"></span>
							Kitchen Open
						</div>
					</div>
					
					<h1 class="mt-8 text-6xl font-semibold leading-[1.1] tracking-tight sm:text-7xl lg:text-8xl">
						{dict.hero.title.split(' ').slice(0, -1).join(' ')} 
						<span class="text-[color:var(--accent)]">{dict.hero.title.split(' ').slice(-1)}</span>
					</h1>
					
					<p class="mt-8 max-w-xl text-lg leading-relaxed text-[color:var(--muted)] lg:text-xl">
						{dict.hero.subtitle}
					</p>
					
					<div class="mt-10 flex flex-wrap gap-4">
						<a href="#menu" class="group relative overflow-hidden rounded-full bg-[color:var(--ink)] px-8 py-4 font-semibold text-white transition-all hover:bg-[color:var(--accent)] hover:shadow-2xl hover:shadow-[color:var(--accent)]/30">
							<span class="relative z-10">{dict.hero.primaryCta}</span>
						</a>
						<a href={localePath(locale, '/checkout/')} class="rounded-full border border-[color:var(--line)] bg-white/80 px-8 py-4 font-semibold backdrop-blur-md transition-all hover:bg-white">
							{dict.hero.secondaryCta}
						</a>
					</div>

					<div class="mt-12 grid gap-4 sm:grid-cols-3">
						{dict.highlights.map((item, index) => (
							<div class="group flex items-center gap-3 rounded-2xl bg-white/40 p-4 transition-all hover:bg-white/60 hover:shadow-lg" style={`animation-delay:${index * 100}ms`}>
								<div class="h-1.5 w-1.5 rounded-full bg-[color:var(--gold)] group-hover:scale-150 transition-transform"></div>
								<p class="text-xs font-medium uppercase tracking-wider text-[color:var(--muted)]">{item}</p>
							</div>
						))}
					</div>
				</div>

				<div class="hero-image-container fade-up relative" style="animation-delay: 200ms">
					<!-- Ambient Glow -->
					<div class="absolute -inset-4 rounded-[3rem] bg-gradient-to-tr from-[color:var(--accent)]/10 to-[color:var(--gold)]/20 blur-3xl opacity-50"></div>
					
					<div class="relative overflow-hidden rounded-[3rem] border border-white/20 shadow-2xl">
						<img 
							src="/images/hero.png" 
							alt="Premium Sushi Selection" 
							class="hero-image aspect-[4/5] w-full object-cover lg:aspect-auto h-[600px]"
						/>
						
						<!-- Floating Glass Card -->
						<div class="glass-card absolute right-6 bottom-6 left-6 rounded-3xl p-6 md:right-10 md:bottom-10 md:left-auto md:w-80">
							<p class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/60">Omakase Experience</p>
							<h2 class="mt-2 text-4xl font-semibold text-white">28 min</h2>
							<p class="mt-3 text-sm leading-relaxed text-white/80">
								Freshly prepared by our master chefs and delivered to your doorstep at Kyoto speed.
							</p>
							
							<div class="mt-6 flex items-center gap-4 border-t border-white/10 pt-6">
								<div class="flex -space-x-3">
									{[1,2,3].map(() => (
										<div class="h-8 w-8 rounded-full border-2 border-[color:var(--ink)] bg-[color:var(--bg-deep)]"></div>
									))}
								</div>
								<p class="text-[10px] font-bold uppercase tracking-wider text-white/60">4.9/5 Rating</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="menu" class="section-shell pt-18">
			<div class="mb-8">
				<h2 class="section-title">{dict.menu.title}</h2>
				<p class="section-copy mt-3">{dict.menu.subtitle}</p>
			</div>
			<ShopExperience
				client:load
				locale={locale}
				checkoutHref={localePath(locale, '/checkout/')}
				products={menuProducts}
				labels={{
					all: dict.menu.all,
					categories: dict.menu.categories,
					title: dict.menu.title,
					subtitle: dict.menu.subtitle,
					details: dict.menu.details,
					addToCart: dict.menu.addToCart,
					popular: dict.menu.popular,
					tags: dict.tags,
					cart: dict.cart,
					product: dict.product,
				}}
			/>
		</section>

		<section id="story" class="section-shell pt-18">
			<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_1fr]">
				<div class="paper-panel rounded-[2.5rem] p-8">
					<h2 class="section-title">{dict.story.title}</h2>
					<p class="section-copy mt-4">{dict.story.body}</p>
					<div class="mt-8 grid gap-3 sm:grid-cols-3">
						{dict.story.stats.map((item) => (
							<div class="rounded-[1.75rem] bg-white/70 p-4 text-sm leading-6 text-[color:var(--muted)]">{item}</div>
						))}
					</div>
				</div>
				<div class="paper-panel rounded-[2.5rem] p-8">
					<p class="pill bg-[color:var(--gold)]/15 text-[color:var(--gold)]">{dict.seo.faqTitle}</p>
					<div class="mt-6 space-y-4">
						{dict.seo.faqs.map((faq) => (
							<details class="rounded-[1.75rem] bg-white/70 p-5">
								<summary class="cursor-pointer text-lg font-semibold">{faq.q}</summary>
								<p class="mt-3 text-sm leading-7 text-[color:var(--muted)]">{faq.a}</p>
							</details>
						))}
					</div>
				</div>
			</div>
		</section>
	</main>

	<script type="application/json" id="menu-bootstrap" set:html={JSON.stringify(bootstrappedCatalog)} />
</BaseLayout>
