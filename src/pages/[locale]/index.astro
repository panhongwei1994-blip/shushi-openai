---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LanguageSwitcher } from '../../components/LanguageSwitcher';
import { ShopExperience } from '../../components/ShopExperience';
import { menuCategories, menuProducts } from '../../data/menu';
import { getDictionary } from '../../lib/translations';
import { defaultLocale, isLocale, localePath, locales, type Locale } from '../../lib/i18n';
import { siteConfig } from '../../lib/site';

export function getStaticPaths() {
	return locales.filter((locale) => locale !== defaultLocale).map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
if (!isLocale(localeParam)) {
	throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale = localeParam as Locale;
const dict = getDictionary(locale);
const pathname = `/${locale}/`;

const menuSchema = {
	'@context': 'https://schema.org',
	'@type': 'Menu',
	name: `${siteConfig.name} menu`,
	hasMenuSection: menuCategories.map((category) => ({
		'@type': 'MenuSection',
		name: dict.menu.categories[category],
		hasMenuItem: menuProducts
			.filter((product) => product.category === category)
			.map((product) => ({
				'@type': 'MenuItem',
				name: product.title[locale],
				description: product.description[locale],
				image: `${siteConfig.url}${product.image}`,
				offers: {
					'@type': 'Offer',
					priceCurrency: siteConfig.currency,
					price: product.price,
				},
			})),
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: dict.seo.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const bootstrappedCatalog = {
	currency: siteConfig.currency,
	locale,
	categories: menuCategories,
	products: menuProducts.map((product) => ({
		id: product.id,
		slug: product.slug,
		category: product.category,
		price: product.price,
		title: product.title[locale],
		description: product.description[locale],
	})),
};

const testimonials = dict.testimonials.items.map((item, index) => ({
	...item,
	avatar: `/images/testimonials/avatar-0${index + 1}.webp`,
}));
---

<BaseLayout
	locale={locale}
	title={dict.meta.homeTitle}
	description={dict.meta.homeDescription}
	pathname={pathname}
	schema={[menuSchema, faqSchema]}
>
	<header class="section-shell relative z-50 pt-6">
		<div class="paper-panel fade-up flex items-center justify-between rounded-full px-5 py-4">
			<a href={pathname} class="flex items-center gap-3">
				<span class="grid h-10 w-10 place-items-center rounded-full bg-[color:var(--ink)] text-sm font-semibold text-white">寿</span>
				<div>
					<p class="text-xs uppercase tracking-[0.3em] text-[color:var(--muted)]">{siteConfig.tagline}</p>
				</div>
			</a>
			<nav class="hidden items-center gap-6 text-sm font-medium text-[color:var(--muted)] md:flex">
				<a href="#menu">{dict.nav.menu}</a>
				<a href="#story">{dict.nav.story}</a>
				<a href={localePath(locale, '/checkout/')}>{dict.nav.checkout}</a>
			</nav>
			<LanguageSwitcher client:load currentLocale={locale} pathname={pathname} />
		</div>
	</header>

	<main class="pb-24 lg:pb-32">
		<section class="section-shell pt-6 sm:pt-12">
			<!-- Hero Container: Vertical on mobile, horizontal on large screens -->
			<div class="relative flex flex-col gap-8 lg:grid lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16">
				
				<!-- Image Container (First on mobile) -->
				<div class="hero-image-container fade-up order-1 lg:order-2" style="animation-delay: 100ms">
					<div class="relative aspect-[4/5] overflow-hidden rounded-[2.5rem] border border-white/20 shadow-2xl sm:aspect-square lg:aspect-[4/5] xl:aspect-[16/10]">
						<img 
							src="/images/hero.png" 
							alt="Premium Sushi Selection" 
							class="hero-image h-full w-full object-cover"
						/>
						
						<!-- Mobile Glass Badge -->
						<div class="glass-card absolute bottom-6 left-6 rounded-2xl px-4 py-3 sm:hidden">
							<div class="flex items-center gap-2">
								<span class="pulse-dot"></span>
								<p class="text-[10px] font-bold uppercase tracking-widest text-white">Kitchen Open</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Text Content Container -->
				<div class="fade-up order-2 lg:order-1" style="animation-delay: 200ms">
					<div class="hidden items-center gap-3 lg:flex">
						<div class="pill bg-[color:var(--accent)]/10 text-[color:var(--accent)]">{dict.hero.eyebrow}</div>
						<div class="flex items-center gap-2 rounded-full border border-[color:var(--line)] bg-white/50 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-[color:var(--muted)] backdrop-blur-sm">
							<span class="pulse-dot"></span>
							Kitchen Open
						</div>
					</div>
					
					<h1 class="fluid-h1 mt-6 max-w-xl font-semibold">
						{dict.hero.title.includes(',') ? dict.hero.title.split(',')[0] : dict.hero.title.split('—')[0]}
						<span class="block text-[color:var(--accent)]">{dict.hero.title.includes(',') ? dict.hero.title.split(',')[1] : dict.hero.title.split('—')[1] || ''}</span>
					</h1>
					
					<p class="fluid-p mt-6 max-w-md text-[color:var(--muted)]">
						{dict.hero.subtitle.split(/[。.]/)[0]}{dict.locale === 'zh' ? '。' : '.'}
					</p>
					
					<div class="mt-8 flex flex-wrap gap-4">
						<a href="#menu" class="group relative overflow-hidden rounded-full bg-[color:var(--ink)] px-8 py-4 font-semibold text-white transition-all hover:bg-[color:var(--accent)] hover:shadow-2xl hover:shadow-[color:var(--accent)]/30">
							<span class="relative z-10">{dict.hero.primaryCta}</span>
						</a>
						<a href={localePath(locale, '/checkout/')} class="rounded-full border border-[color:var(--line)] bg-white/80 px-8 py-4 font-semibold backdrop-blur-md transition-all hover:bg-white">
							{dict.hero.secondaryCta}
						</a>
					</div>

					<div class="mt-12 hidden gap-6 sm:flex lg:flex-col lg:gap-4 xl:flex-row">
						{dict.highlights.map((item, index) => (
							<div class="flex items-center gap-2" style={`animation-delay:${index * 100}ms`}>
								<div class="h-1 w-1 rounded-full bg-[color:var(--gold)]"></div>
								<p class="text-[10px] font-bold uppercase tracking-widest text-[color:var(--muted)]/60">{item}</p>
							</div>
						))}
					</div>
				</div>

				<!-- Desktop Floating Stats -->
				<div class="glass-card absolute -right-8 bottom-12 hidden rounded-3xl p-6 shadow-2xl backdrop-blur-xl lg:block xl:w-72" style="animation-delay: 300ms">
					<p class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/60">Kyoto Quality</p>
					<h2 class="mt-2 text-4xl font-semibold text-white">28 min</h2>
					<div class="mt-4 flex items-center gap-2">
						<div class="flex -space-x-2">
							{[1,2,3].map(() => <div class="h-6 w-6 rounded-full border border-white/20 bg-white/10" />)}
						</div>
						<span class="text-[10px] font-medium text-white/50">4.9/5 Rating</span>
					</div>
				</div>
			</div>
		</section>

		<section id="menu" class="section-shell pt-18">
			<div class="mb-8">
				<h2 class="section-title">{dict.menu.title}</h2>
				<p class="section-copy mt-3">{dict.menu.subtitle}</p>
			</div>
			<ShopExperience
				client:load
				locale={locale}
				checkoutHref={localePath(locale, '/checkout/')}
				products={menuProducts}
				labels={{
					all: dict.menu.all,
					categories: dict.menu.categories,
					title: dict.menu.title,
					subtitle: dict.menu.subtitle,
					details: dict.menu.details,
					addToCart: dict.menu.addToCart,
					popular: dict.menu.popular,
					tags: dict.tags,
					cart: dict.cart,
					product: dict.product,
				}}
			/>
		</section>

		<section id="story" class="section-shell pt-12 sm:pt-18">
			<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_1fr]">
				<div id="testimonials" class="paper-panel rounded-[2rem] p-5 sm:rounded-[2.5rem] sm:p-8">
					<p class="pill bg-[color:var(--gold)]/15 text-[color:var(--gold)]">{dict.testimonials.title}</p>
					<h2 class="mt-3 text-[1.55rem] font-semibold leading-none sm:mt-4 sm:text-[2.25rem]">{dict.testimonials.subtitle}</h2>
					<p class="mt-3 max-w-2xl text-sm leading-6 text-[color:var(--muted)] sm:mt-4 sm:text-base sm:leading-7">{dict.testimonials.intro}</p>
					<div class="mt-5 grid gap-3 sm:mt-6 sm:gap-4">
						{testimonials.map((item) => (
							<article class="rounded-[1.5rem] bg-white/70 p-4 sm:rounded-[1.9rem] sm:p-5">
								<div class="flex items-center gap-3">
									<img src={item.avatar} alt={item.name} loading="lazy" class="h-12 w-12 rounded-full object-cover ring-2 ring-white/80 sm:h-14 sm:w-14" />
									<div class="min-w-0">
										<p class="text-base font-semibold text-[color:var(--ink)]">{item.name}</p>
										<div class="mt-1 flex items-center gap-1 text-[13px] text-[color:var(--gold)] sm:text-sm">
											<span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
										</div>
									</div>
								</div>
								<p class="mt-3 text-sm leading-6 text-[color:var(--muted)] sm:mt-4 sm:leading-7">{item.quote}</p>
							</article>
						))}
					</div>
				</div>
				<div class="paper-panel rounded-[2rem] p-5 sm:rounded-[2.5rem] sm:p-8">
					<p class="pill bg-[color:var(--gold)]/15 text-[color:var(--gold)]">{dict.seo.faqTitle}</p>
					<h2 class="mt-3 text-[1.55rem] font-semibold leading-none sm:mt-4 sm:text-[2.25rem]">FAQs</h2>
					<div class="mt-5 space-y-3 sm:mt-6 sm:space-y-4">
						{dict.seo.faqs.map((faq) => (
							<details class="group rounded-[1.5rem] bg-white/70 p-4 sm:rounded-[1.75rem] sm:p-5">
								<summary class="cursor-pointer list-none text-base font-semibold sm:text-lg">
									<div class="flex items-start justify-between gap-4">
										<span>{faq.q}</span>
										<span class="mt-0.5 text-[color:var(--muted)] transition group-open:rotate-45">+</span>
									</div>
								</summary>
								<p class="mt-2 text-sm leading-6 text-[color:var(--muted)] sm:mt-3 sm:leading-7">{faq.a}</p>
							</details>
						))}
					</div>
				</div>
			</div>
		</section>
	</main>

	<script type="application/json" id="menu-bootstrap" set:html={JSON.stringify(bootstrappedCatalog)} />
</BaseLayout>
