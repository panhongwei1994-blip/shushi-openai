---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CheckoutClient } from '../../components/CheckoutClient';
import { getDictionary } from '../../lib/translations';
import { defaultLocale, isLocale, localePath, locales, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
	return locales.filter((locale) => locale !== defaultLocale).map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale ?? 'en';
if (!isLocale(localeParam)) throw new Error(`Unsupported locale: ${localeParam}`);
const locale = localeParam as Locale;
const dict = getDictionary(locale);
const pathname = `/${locale}/checkout/`;
---

<BaseLayout
	locale={locale}
	title={dict.meta.checkoutTitle}
	description={dict.checkout.subtitle}
	pathname={pathname}
>
	<main class="section-shell py-10">
		<div class="mb-8 flex items-center justify-between gap-4">
			<a href={localePath(locale)} class="text-sm font-medium text-[color:var(--muted)]">← {dict.checkout.backToMenu}</a>
			<a href={localePath(locale)} class="grid h-10 w-10 place-items-center rounded-full bg-[color:var(--ink)] text-sm font-semibold text-white">寿</a>
		</div>
		<CheckoutClient
			client:load
			locale={locale}
			labels={{
				checkout: dict.checkout,
				cart: {
					subtotal: dict.cart.subtotal,
					deliveryFee: dict.cart.deliveryFee,
					total: dict.cart.total,
					remove: dict.cart.remove,
				},
			}}
		/>
	</main>
</BaseLayout>
